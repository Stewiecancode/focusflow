# RESEND_API_KEY=
# EMAIL_FROM=FocusFlow <reminders@your-verified-domain.example>
PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=
# REMINDER_CRON_SECRET=<at-least-32-random-characters>
# REMINDER_ALWAYS_ON=false
# REMINDER_WORKER_DISABLED=false
